{
    "compilerOptions": {
        "types": ["node", "jest", "@testing-library/jest-dom"],
        "noImplicitAny": true,
        "module": "es2020",
        "strict": true,
        "target": "es6",
        "jsx": "react-jsx",
        "allowJs": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "paths": {
            "@/*":["./src/*"]
        },
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true
    },
    "ts-node": {
        "compilerOptions": {
            "skipLibCheck": true,
            "module": "commonjs",
            "types": ["node", "jest"]
        }
    },
    "include": [
        "src",
        ".config/jest/setupTest.ts"
    ]
}